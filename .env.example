# --- Database ---
# Path to the local sqlite file used by Drizzle + better-sqlite3.
DATABASE_PATH=./data/app.db

# --- Object storage (S3-compatible: Cloudflare R2 or AWS S3) ---
# If any of these are missing, the app falls back to local filesystem
# storage under ./data/uploads and ./data/outputs (see lib/storage.ts).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- ASR vendors (tried in this order by default: deepgram, assemblyai, whisper) ---
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=
# Use a local/self-hosted Whisper instead of the OpenAI API: point this at an
# OpenAI-compatible server's /v1 URL (e.g. http://localhost:8000/v1) and set
# WHISPER_MODEL to the model that server expects. No OpenAI key needed then.
WHISPER_BASE_URL=
WHISPER_MODEL=
WHISPER_API_KEY=
# Whisper on Hugging Face: set HF_TOKEN (huggingface.co/settings/tokens) and
# WHISPER_PROVIDER=huggingface to use it (applies to every language). Optional:
# HF_WHISPER_MODEL (default openai/whisper-large-v3), HF_ASR_URL (a dedicated
# Inference Endpoint URL).
HF_TOKEN=
WHISPER_PROVIDER=
HF_WHISPER_MODEL=
HF_ASR_URL=
# Gemini as the transcriber (no OpenAI/Whisper needed): set GEMINI_API_KEY and
# WHISPER_PROVIDER=gemini. Word timing is approximate (Gemini returns timed
# segments, not per-word times). Optional: GEMINI_ASR_MODEL.
GEMINI_ASR_MODEL=
# Optional: comma-separated override of the fallback order, e.g. "whisper,deepgram"
ASR_VENDOR_ORDER=

# Roman Urdu captions: Whisper (needs OPENAI_API_KEY) transcribes, then an LLM
# transliterates. Set GEMINI_API_KEY to use Gemini for that step (it takes
# priority when set); otherwise OpenAI is used.
GEMINI_API_KEY=
# Optional overrides: GEMINI_MODEL (default gemini-2.5-flash), ROMANIZE_MODEL
# (OpenAI, default gpt-4o-mini), ROMANIZE_PROVIDER=openai to force OpenAI.
GEMINI_MODEL=
ROMANIZE_MODEL=
ROMANIZE_PROVIDER=

# --- Auth (NextAuth / Auth.js) ---
# If Google OAuth vars are missing, the Google sign-in button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# If EMAIL_SERVER/EMAIL_FROM are missing, magic-link sign-in is hidden.
# EMAIL_SERVER is an SMTP connection string, e.g. smtp://user:pass@smtp.example.com:587
EMAIL_SERVER=
EMAIL_FROM=

# Username/password sign-in. These create (and recover) the first admin, who
# can then add users at /admin. Leave empty in dev to use the auto dev-user.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required in production for NextAuth session encryption. Generate with:
#   npx auth secret
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Retention cron ---
RETENTION_DAYS=7
